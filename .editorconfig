root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{java,xml}]
indent_size = 4

[*.py]
indent_size = 4
max_line_length = 100

[*.{yml,yaml,json,ts,js,vue,css,scss,html}]
indent_size = 2

[*.md]
# 文档里的行尾空格有时是有意的（换行、表格对齐前），不强制清理
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{bat,cmd}]
end_of_line = crlf
