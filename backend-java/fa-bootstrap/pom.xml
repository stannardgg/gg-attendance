<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.fa</groupId>
    <artifactId>face-attendance</artifactId>
    <version>0.2.0-SNAPSHOT</version>
  </parent>

  <artifactId>fa-bootstrap</artifactId>
  <name>fa-bootstrap</name>
  <description>启动模块：配置装配、可执行 jar、数据库迁移资源</description>

  <dependencies>
    <dependency>
      <groupId>com.fa</groupId>
      <artifactId>fa-auth</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fa</groupId>
      <artifactId>fa-org</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      集成测试要 POST 带 body 并断言 401。JDK 自带的 HttpURLConnection 在
      「流式写入请求体 + 收到 401」时会抛 HttpRetryException（cannot retry due to
      server authentication），这是 JDK 的已知行为，不是服务端问题。
      换 Apache HttpClient 才能正常拿到 401 的响应体。
    -->
    <dependency>
      <groupId>org.apache.httpcomponents.client5</groupId>
      <artifactId>httpclient5</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>com.fa.bootstrap.FaceAttendanceApplication</mainClass>
        </configuration>
      </plugin>

      <!--
        跨模块覆盖率聚合。
        为什么需要：集成测试全部跑在 fa-bootstrap 的进程里，它们覆盖的是
        fa-auth / fa-org 的代码。各模块自己的 jacoco 报告只统计本模块的 test，
        所以 fa-auth 单看只有 1%（它本来就没几个单测）。聚合后才能看到真实数字。
      -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>aggregate-report</id>
            <phase>verify</phase>
            <goals>
              <goal>report-aggregate</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!--
        把仓库根的 db/migration 复制进 classpath。
        这样 Flyway 用 classpath:db/migration 就能读写到迁移脚本：
          - 本地 mvn spring-boot:run 能读到
          - 打成 jar 后也能读到（不用挂外部卷）
          - 不用在 backend-java 下再复制一份 SQL，保持「DDL 只有一处」的契约
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-db-migration</id>
            <phase>process-resources</phase>
            <goals><goal>copy-resources</goal></goals>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}/db/migration</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.basedir}/../../db/migration</directory>
                  <filtering>false</filtering>
                  <includes>
                    <include>**/*.sql</include>
                  </includes>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
