# =====================================================================
# 人脸签到系统 · 部署环境变量（§12.3）
# =====================================================================
# 用法：cp .env.example .env && 逐项改成真实值
# 纪律：.env 不进仓库；本文件只留占位符，不放真实密钥。
# 生成随机值：openssl rand -hex 32
# =====================================================================

# ---- 通用 ----
TZ=Asia/Shanghai
APP_ENV=prod
# 宿主机暴露端口（80/443 被占用时改成 8088/8443）
HTTP_PORT=80
HTTPS_PORT=443

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=change-me-root-please
MYSQL_DATABASE=face_attendance
MYSQL_USER=fa_app
MYSQL_PASSWORD=change-me-app-please
MYSQL_FACE_RO_USER=face_ro
MYSQL_FACE_RO_PASSWORD=change-me-face-ro-please

# ---- Redis ----
REDIS_PASSWORD=change-me-redis-please

# ---- Java ----
# JWT_SECRET 至少 32 字节；jjwt 对短密钥会直接拒绝启动
JWT_SECRET=change-me-32-bytes-minimum-0123456789abcdef
JWT_ACCESS_TTL=1800
JWT_REFRESH_TTL=604800
INTERNAL_TOKEN=change-me-internal-token
BOOTSTRAP_ADMIN_USERNAME=admin
# 首次启动后立即改密；留空则不创建管理员
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password
# 浏览器访问 Agent 的地址（SSO 链接用），生产改成 https://<域名>/agent
AGENT_PUBLIC_URL=https://localhost/agent
# 人脸向量字段级加密密钥（CR-012）：AES-256 key 的 base64，生成：openssl rand -base64 32。
# 留空 = 向量明文落库（仅本地/CI 允许）；生产必须配置，配错长度会拒绝启动。
FA_VECTOR_AES_KEY=
# 备份文件加密口令（backup.sh / restore.sh 用，openssl enc -pass env 引用）。
# 留空 = 备份不加密（不推荐，备份里有全量向量）。与 FA_VECTOR_AES_KEY 用不同的值。
BACKUP_AES_KEY=

# ---- Face ----
# 只列 face 服务真正读环境变量的项：比对阈值 0.45 / margin 0.06 / 多脸 90px
# 属于 sys_config 的运行时数据（§10.5），不走环境变量，改了这里不会有任何效果。
LIVENESS_THRESHOLD=0.55
IDENTITY_SIM=0.55
# 允许客户端指定挑战动作（CR-010）。生产必须 0；只有跑 16.3 负例的验收环境才开 1
ALLOW_ACTION_HINT=0
# 挑战会话有效期（秒），默认 60 = 契约值。CPU 推理慢的机器跑高并发时可放宽，
# 但放宽等于容忍更慢的签到，生产优先扩容（文档 R3）而不是调这个
# FA_CHALLENGE_TTL_SEC=60
# ONNX 会话线程数；每个 worker 约 400MB，内存 <8GB 的机器建议降到 1~2
FACE_WORKERS=4
MODEL_DIR=/app/models
# 向量快照轮询间隔（秒），CR-002
VECTOR_SYNC_INTERVAL=60

# ---- Agent ----
# 留空 = 未配置模型，服务走规则降级（§11.8）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0.2
# 推理型模型先出 reasoning 再出正文，1024 容易被 reasoning 吃满导致正文为空
LLM_MAX_TOKENS=2048
# 30s 对长 prompt + 推理模型偏紧，超时会被当成"模型不可用"降级
LLM_TIMEOUT_SEC=60
AGENT_LEVEL_L3=false
CONFIRM_TTL_SEC=60
UNDO_WINDOW_SEC=1800

# ---- MinIO ----
MINIO_ROOT_USER=fa-minio
MINIO_ROOT_PASSWORD=change-me-minio-please

# ---- 镜像源 ----
# 国内网络把这两个改成 docker.m.daocloud.io 可显著加快构建
DOCKER_REGISTRY=docker.io
